datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  avatar       String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  boards       Board[]        @relation("BoardOwner")
  memberships  BoardMember[]
  activityLogs ActivityLog[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Board {
  id          String   @id @default(uuid())
  name        String
  description String?
  inviteCode  String   @unique @default(cuid())
  isPublic    Boolean  @default(false)
  ownerId     String
  owner       User     @relation("BoardOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  columns      Column[]
  members      BoardMember[]
  activityLogs ActivityLog[]

  @@map("boards")
}

model BoardMember {
  id         String     @id @default(uuid())
  boardId    String
  board      Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)

  userId     String?
  user       User?      @relation(fields: [userId], references: [id])

  guestName  String?
  guestColor String?

  memberRole MemberRole @default(EDITOR)
  joinedAt   DateTime   @default(now())

  @@unique([boardId, userId])
  @@map("board_members")
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

model Column {
  id        String   @id @default(uuid())
  name      String
  order     Int
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]

  @@map("columns")
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  order       Int
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime?
  columnId    String
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)

  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  activityLogs ActivityLog[]

  @@index([columnId])
  @@map("tasks")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model ActivityLog {
  id        String     @id @default(uuid())
  boardId   String
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)

  taskId    String?
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  actorName String

  action    ActionType
  metadata  Json?
  createdAt DateTime   @default(now())

  @@map("activity_logs")
}

enum ActionType {
  TASK_CREATED
  TASK_MOVED
  TASK_UPDATED
  TASK_DELETED
  COLUMN_CREATED
  COLUMN_DELETED
  MEMBER_JOINED
}